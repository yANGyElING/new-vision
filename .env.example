NV_HTTP_PORT=8080
NV_HTTP_ADDR=:8080
NV_SIP_PORT=5060
NV_LOG_LEVEL=info
NV_SHUTDOWN_TIMEOUT=10s
NV_HEALTH_TIMEOUT=1s

# Public local-development values only. Replace all values outside local use.
NV_POSTGRES_DB=new_vision
NV_POSTGRES_USER=new_vision
NV_POSTGRES_PASSWORD=local-postgres-password
NV_POSTGRES_SSLMODE=disable

NV_REDIS_PASSWORD=local-redis-admin-password
NV_REDIS_NODEAPP_PASSWORD=local-redis-nodeapp-password
NV_REDIS_ACCESS_PASSWORD=local-redis-access-password
NV_REDIS_DB=0

NV_ACCESS_RPC_URL=http://node-access:8090/rpc
NV_ACCESS_RPC_TIMEOUT=3s
NV_ACCESS_POLL_INTERVAL=1s
NV_ACCESS_INSTANCE_ID=access-01
NV_KEEPALIVE_TIMEOUT=180
NV_SIP_REALM=3402000000

# JWT auth (required; min 32 bytes). Change this outside local use.
NV_JWT_SECRET=local-development-jwt-secret-change-me-0123456789abcdef
NV_JWT_TTL=24h
# Optional: create the initial node_admin (admin) user on first startup.
NV_SEED_ADMIN_PASSWORD=
